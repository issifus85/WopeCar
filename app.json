{
  "expo": {
    "name": "WopeCar",
    "slug": "WopeCar",
    "version": "1.0.0",
    "scheme": "wopecar",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "WopeCar uses Face ID to unlock the app when Biometric Login is enabled in Settings.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.wopecar.WopeCar"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.wopecar.WopeCar"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "WopeCar accesses your photos so you can attach license and inspection documents.",
          "cameraPermission": "WopeCar uses your camera to capture vehicle inspection photos."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "WopeCar uses your location to tag where vehicle inspection photos were taken."
        }
      ],
      "expo-video",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo-mark-navy.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7e196e65-f830-4c7d-a776-7c474cd78cf4"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/7e196e65-f830-4c7d-a776-7c474cd78cf4"
    }
  }
}
