{
  "expo": {
    "name": "WopeCar",
    "slug": "WopeCar",
    "version": "1.0.0",
    "scheme": "wopecar",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "WopeCar uses Face ID to unlock the app when Biometric Login is enabled in Settings."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "WopeCar accesses your photos so you can attach license and inspection documents.",
          "cameraPermission": "WopeCar uses your camera to capture vehicle inspection photos."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "WopeCar uses your location to tag where vehicle inspection photos were taken."
        }
      ],
      "expo-video",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo-mark-navy.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ]
  }
}
